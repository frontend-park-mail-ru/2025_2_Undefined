<div class="home">
  <div class="header">
    <div class="header__wrapper">
      <div class="header__column header__column--left">
        <div class="menu">
            {{> components/action-button/action-button type='menu' icon='menu' action='menu'}}
          <div class="menu__wrapper">
            {{> components/context-menu/context-menu direction='top' items=mainMenu}}
          </div>
        </div>
        <div class="search">
          <i class="icon search-icon"></i>
          <input class="search__input" type="text" placeholder="Поиск">
        </div>
      </div>
      
      <div class="header__column header__column--middle">
        <!-- Заголовок будет заполняться динамически -->
      </div>
      
      <div class="header__column header__column--right">
        <div class="user-header">
          <div class="user-header__info">
            <div class="user-header__details">
              <div class="user-header__name">{{user.name}}</div>
            </div>
            <div class="user-header__avatar">
              {{> components/avatar/avatar placeholder=user.placeholder}}
            </div>
          </div>
        </div>
        <div class="header__sign-out" id="signOut">
          <i class="icon icon--size-lg signOut-icon"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="content">
    <div class="chats-panel">
      {{#if isProfileOpen}}
        <div class="profile">
          <h2>Профиль</h2>
          <div class="profile__info">
            <div class="profile__avatar">{{user.placeholder}}</div>
            <div class="profile__name">{{user.name}}</div>
            <div class="profile__username">@{{user.username}}</div>
            <div class="profile__phone">{{user.phone_number}}</div>
          </div>
        </div>
      {{else}}
        {{#if hasChats}}
          <div class="chats-panel__list scrollable">
            {{#each chats}}
              <div class="chat-template" data-chat-id="{{id}}">
                <div class="chat-template__avatar">{{placeholder}}</div>
                <div class="chat-template__info">
                  <div class="chat-template__name">{{name}}</div>
                  <div class="chat-template__last-message">
                    {{last_message.string}}
                  </div>
                </div>
                <div class="chat-template__date">
                  {{last_message.created_at_formatted}}
                </div>
              </div>
            {{/each}}
          </div>
          <div class="chat-create">

            {{> components/action-button/action-button type='action' icon='edit' action='create'}}
            {{> components/context-menu/context-menu direction='bottom' items=newChats}} 
          </div>
        {{else}}
          <div class="chats-panel__empty">
            <p>У вас пока нет чатов</p>
          </div>
        {{/if}}
      {{/if}}
    </div>

    <div class="chat-area">
      <div class="chat-area__placeholder">
        <p>Выберите чат для начала общения</p>
      </div>
    </div>
  </div>
</div>