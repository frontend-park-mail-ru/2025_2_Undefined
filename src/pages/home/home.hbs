<div class='home'>
  <div class='header'>
    <div class='header-wrapper'>
      <div class='left-column'>
        <div class='menu-btn'>
          {{#if activeTabChats}}
            <i class='icon menu-icon' id='menuBtn'></i>
          {{/if}}
          {{#if activeTabContacts}}
              <i class='icon menu-icon' id='backBtn'></i>
          {{/if}}
        </div>
        {{#if activeTabChats}}
        <div class='search-wrapper'>
          <i class='search-icon'></i>
          <input class='search' type='text' placeholder='Поиск' />
        </div>
        {{/if}}
        {{#if activeTabContacts}}
        <div class='search-wrapper'>
          <i class='search-icon'></i>
          <input class='search' type='text' placeholder='Поиск' />
        </div>
        {{/if}}
        {{#if activeTabProfile}}
          <button class="button action-button" dataAction='close-menu'>
            <i class="icon leftArrow-icon"></i>
          </button>
        {{/if}} 
      </div>
      <div class='middle-column'>
        {{#if isChatOpen}}
          <div class='contact-item' id="nameOfChat"
              data-contact-id='{{chatId}}'
          >
              <div class='contact-avatar'>
                  {{> components/avatar/avatar placeholder=this.placeholder}}
              </div>
              <div class='contact-info'>
                  <div class='contact-name'>{{chatName}}</div>
              </div>
          </div>
        {{/if}}
      </div>
      <div class='right-column'>
        <div class='user-header'>
          <div class='user-info'>
            <div class='user-details'>
              <div class='user-name'>{{user.name}}</div>
            </div>
            <div class='avatar'>
              {{> components/avatar/avatar placeholder=user.placeholder }}
            </div>
          </div>
        </div>
        <div class='signOut-btn' id="signOut">
          <i class='signOut-icon'></i>
        </div>
      </div>
    </div>
  </div>

  <div class='content'>
    <!-- Левая колонка - список диалогов -->

    <div class='content-left-column' id="contentLeftColumn">
      {{#if activeTabChats}}
        {{#if hasChats}}
          <div class='items-list-scrollable'>
            {{#each chats}}
            {{> components/chat/chat-template
            placeholder=this.placeholder
            name=this.name
            last-message-date=this.last_message.created_at_formatted
            last-message=this.this.last_message.string
            id=this.id
            }}
            {{/each}}

          </div>
        {{else}}
        <div class="hasNoItems">
          <p>У вас пока нет чатов</p>
        </div>
        {{/if}}
        <div class="newChatButton">
          {{> components/action-button/action-button icon='edit'}}  
        </div>
      {{/if}}

      
      {{#if activeTabContacts}}
        {{#if hasContacts}}
          <div class='items-list-scrollable'>
            {{#each contacts}}
              {{> components/contact/contact
              placeholder=contact.placeholder
              name=contact.name
              id=contact.id
              }}
            {{/each}}

          </div>
        {{else}}
        <div class="hasNoItems">
          <p>У вас пока нет контактов</p>
        </div>
        {{/if}}
        <div class="newContactButton">
          {{> components/add-contact-btn/add-contact-btn}}  
        </div>
      {{/if}}

      {{#if activeTabProfile}}
        {{> components/profile/profile
          placeholder=user.placeholder
          name=user.name
          username=user.username
          phone_number=user.phone_number
        }}
      {{/if}}
    </div>

    <!-- Средняя колонка - чат -->
    <div class='content-middle-column'>
      {{#if isChatOpen}}
        <div class="content-middle-column-center">
          <div class="content-middle-column-center-messages">
            {{#each messages}}
              {{> components/message/message 
                text=this.text
                time=this.created_at
                isMine=this.isMine
                isSystem=this.isSystem
              }}
            {{/each}}

          </div>
          <div class="content-middle-column-center-input">
            {{> components/input-message/input-message id=chatId}}
          </div>
        </div>
      {{/if}}
    </div>
  </div>