<div class="home">
  <div class="header">
    <div class="header__wrapper">
      <div class="header__column header__column--left">
        <div class="menu">
          {{> components/action-button/action-button type='menu' icon='menu'}}
          <div class="menu__wrapper">
            {{> components/context-menu/context-menu direction='top' items=mainMenu}}
          </div>
        </div>
        <div class="search">
          <i class="search__icon"></i>
          <input class="search__input" type="text" placeholder="Поиск">
        </div>
      </div>
      
      <div class="header__column header__column--middle">
        <!-- Заголовок будет заполняться динамически -->
      </div>
      
      <div class="header__column header__column--right">
        <div class="user">
          <div class="user__details">
            <div class="user__name">{{user.name}}</div>
          </div>
          <div class="user__avatar">
            {{> components/avatar/avatar placeholder=user.placeholder }}
          </div>
        </div>
        <div class="sign-out" id="signOut">
          <i class="sign-out__icon signOut-icon"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="content">
    <div class="chats-panel">
      {{#if hasChats}}
        <div class="chats-panel__list scrollable">
          {{#each chats}}
            {{> components/chat/chat-template
            placeholder=this.placeholder
            name=this.name
            last-message-date=this.last_message.created_at_formatted
            last-message=this.last_message.string
            }}
          {{/each}}
        </div>
        <div class="chat-create">
          {{> components/action-button/action-button type='action' icon='edit'}}
          <div class="chat-create__menu">
            {{> components/context-menu/context-menu direction='bottom' items=newChats}}
          </div>
        </div>
      {{else}}
        <div class="chats-panel__empty">
          <p>У вас пока нет чатов</p>
        </div>
      {{/if}}
    </div>

    <div class="chat-area">
      <div class="chat-area__placeholder">
        <p>Выберите чат для начала общения</p>
      </div>
    </div>
  </div>
</div>