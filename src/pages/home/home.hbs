<div class="home">
  <div class="header">
    <div class="header__wrapper">
      <div class="header__column header__column--left">
          {{> components/profile/header-profile open=isProfileOpen}}
          <div class="menu">
            {{> components/action-button/action-button type='menu' icon='menu'}}
            <div class="menu__wrapper">
              {{> components/context-menu/context-menu direction='top' items=mainMenu}}
            </div>
          </div>
          <div class="search">
            <i class="search__icon"></i>
            <input class="search__input" type="text" placeholder="Поиск">
          </div>
      </div>
      
      <div class="header__column header__column--middle">
        <!-- Заголовок будет заполняться динамически -->
      </div>
      
      <div class="header__column header__column--right">
      </div>
    </div>
  </div>

    <div class="chats-panel">
      {{#if isProfileOpen}}
        {{> components/profile/profile
          placeholder=user.placeholder
          name=user.name
          username=user.username
          phone_number=user.phone_number
        }}
      {{/if}}
      {{#if activeTabChats}}
        {{#if hasChats}}
          <div class='items-list-scrollable'>
            {{#each chats}}
            {{> components/chat/chat-template
            placeholder=this.placeholder
            name=this.name
            last-message-date=this.last_message.created_at_formatted
            last-message=this.this.last_message.string
            id=this.id
            }}
            {{/each}}

          </div>
        {{else}}
        <div class="hasNoItems">
          <p>У вас пока нет чатов</p>
        </div>
        {{/if}}
        <div class="newChatButton">
          {{> components/action-button/action-button icon='edit'}}  
        </div>
      {{/if}}

      
      {{#if activeTabContacts}}
        {{#if hasContacts}}
          <div class='items-list-scrollable'>
            {{#each contacts}}
              {{> components/contact/contact
              placeholder=contact.placeholder
              name=contact.name
              id=contact.id
              }}
            {{/each}}

          </div>
        {{else}}
        <div class="hasNoItems">
          <p>У вас пока нет контактов</p>
        </div>
        {{/if}}
        <div class="newContactButton">
          {{> components/add-contact-btn/add-contact-btn}}  
        </div>
      {{/if}}
    </div>

    <!-- Средняя колонка - чат -->
    <div class='content-middle-column'>
      {{#if isChatOpen}}
        <div class="content-middle-column-center">
          <div class="content-middle-column-center-messages">
            {{#each messages}}
              {{> components/message/message 
                text=this.text
                time=this.created_at
              }}
            {{/each}}

          </div>
          <div class="content-middle-column-center-input">
            {{> components/input-message/input-message id=chatId}}
          </div>
        </div>
      {{/if}}
    </div>
  </div>
</div>