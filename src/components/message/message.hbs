{{#if isSystem}}
    <div class="systemMessage">
        {{text}}
    </div>
{{else}}
    {{#if isMine}}
        <div class="myMessage message">
            <div class="message-text">
                {{ text }}
            </div>
            <div class="message-time">
                {{ time }}
            </div>
        </div>
    {{else}}
        <div class="notMyMessage message">
            <div class="message-text">
                {{ text }}
            </div>
            <div class="message-time">
                {{ time }}
            </div>
        </div>
    {{/if}}
{{/if}}





