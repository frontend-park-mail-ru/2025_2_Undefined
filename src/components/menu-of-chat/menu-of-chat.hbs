<div id="menuOfChat">
    <div class="menuOfChat">
        
        {{#if isGroup}}
            <div class="menuOfChat-item" id="addUser">
                <div class="menuOfChat-item-icon">
                    <i class="group-icon"></i>
                </div>
                <div class="menuOfChat-item-text">
                    <p>Добавить участника</p>
                </div>
            </div>
        {{/if}}

        <div class="menuOfChat-item" id="deleteChat">
            <div class="menuOfChat-item-icon">
                <i class="user-icon"></i>
            </div>
            <div class="menuOfChat-item-text">
                <p>Удалить чат</p>
            </div>
        </div>

    </div>
</div>
