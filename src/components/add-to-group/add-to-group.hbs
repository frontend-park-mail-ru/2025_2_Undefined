<div class="modal-overlay" id="userDialog">
  <div class="modal-dialog">
    <div class="modal-header">
      <h2>Добавить пользователя в группу</h2>
    </div>
    <div class="modal-body">
      <div class="input-group">
        <input
          type="text"
          id="userNumberInput"
          class="modal-input"
          placeholder="Введите номер пользователя"
          maxlength="50"
        />
        <div class="error-message" id="userNameError"></div>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" id="canceluserBtn">
        Отменить
      </button>
      <button type="button" class="btn btn-primary" id="createuserBtn">
        Добавить
      </button>
    </div>
  </div>
</div>