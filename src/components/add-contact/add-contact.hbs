<div class="modal-overlay" id="contactDialog">
  <div class="modal-dialog">
    <div class="modal-header">
      <h2>Добавить контакт</h2>
    </div>
    <div class="modal-body">
      <div class="input-group">
        <input
          type="text"
          id="contactNumberInput"
          class="modal-input"
          placeholder="Введите номер контакта"
          maxlength="50"
        />
        <div class="error-message" id="contactNameError"></div>
      </div>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" id="cancelContactBtn">
        Отменить
      </button>
      <button type="button" class="btn btn-primary" id="createContactBtn">
        Создать
      </button>
    </div>
  </div>
</div>