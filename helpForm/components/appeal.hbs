<div class="exit">
    <i class='icon close-icon'></i>
</div>

<div class='appeal-item' data-appeal-id='{{id}}'>
    <div class='appeal-info'>
        <div class="info-row">
            <div class="appeal-title">
                <div class='appeal-name'>{{name}} ИМЯ ОБРАЩЕНИЯ </div>
            </div>
            <div class="separator"></div>
        </div>
        <div class="appeal-subtitle">
            <div class='appeal-status'>{{status}} СТАТУС ОБРАЩЕНИЯ </div>
            <div class="appeal-category">{{category}} КАТЕГОРИЯ ОБРАЩЕНИЯ </div>
            <div class="appeal-text">{{text}} ТЕКСТ ОБРАЩЕНИЯ </div>
        </div>
    </div>
</div>